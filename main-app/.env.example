# BN Agent — 运行配置示例（复制为 .env 后填写）
RUST_LOG=info

# ── LLM ───────────────────────────────────────────────
LLM_API_KEY=your_api_key
LLM_MODEL=deepseek-chat
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_THINKING=disabled
LLM_MAX_TOKENS=8192
LLM_MAX_HISTORY=20
IMMEDIATE_CONTEXT_MSGS=200
LLM_LONG_SUMMARY_ENABLED=true
LLM_LONG_SUMMARY_KEEP_RECENT=200
LLM_LONG_SUMMARY_BATCH_SIZE=80
LLM_LONG_SUMMARY_MAX_CHARS=4000
LLM_MAX_TOOL_ROUNDS=20
# 单工具执行超时(秒)，0=禁用。使用本地 Qwen 生图/编辑时建议 0 或 ≥1800
# （生图 5–14 分钟、编辑 7–20+ 分钟，默认 180s 会误判 tool timed out）
# TOOL_TIMEOUT_SECS=0

# ── 插件加载 ──────────────────────────────────────────
# PLUGIN_LOAD=logger-plugin,time-plugin,tg-im-plugin
# PLUGIN_SKIP=

# 插件配置目录（每个插件一个 <plugin-name>.json，WebUI 保存后自动创建）
# PLUGIN_CONFIG_DIR=data/plugin_configs

# 人设文件路径（默认 persona.md；可指向 data/yueyue/persona.md）
# PERSONA_PATH=persona.md

# HTTP API 鉴权 key（未设=不鉴权；本机实际 key 在 .secrets/api_key.txt，已 gitignore）
# API_KEY=

# HTTP 监听地址（默认 127.0.0.1:8080，端口冲突时可改；手机访问改成 0.0.0.0:8080）
# HTTP_BIND=127.0.0.1:8080

# 可选 HTTPS 监听：手机浏览器 getUserMedia 需要安全上下文。
# 证书用 deploy/livekit/tls 下的本地 CA 签发；ca.crt 可从 /call/assets/ca.crt 下载安装。
# HTTPS_BIND=0.0.0.0:18443
# TLS_CERT=E:/BN_agent/deploy/livekit/tls/server.crt
# TLS_KEY=E:/BN_agent/deploy/livekit/tls/server.key

# ── LiveKit 通话（call-livekit-plugin）─────────────────
# 插件配置优先在 WebUI / data/plugin_configs/call-livekit-plugin.json 中填写；
# 下面这些环境变量仅作 fallback（适合不便使用 WebUI 的部署方式）。
# LIVEKIT_URL=ws://192.168.0.101:7880
# LIVEKIT_URL_LOCAL=ws://127.0.0.1:7880
# LIVEKIT_API_URL=http://127.0.0.1:7880
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=
# 浏览器通话页与静态资源目录（默认 <repo>/deploy/livekit）
# CALL_DEPLOY_DIR=E:/BN_agent/deploy/livekit

# ── 本地生图 (ComfyUI) ───────────────────────────────
COMFYUI_URL=http://127.0.0.1:8188
COMFYUI_OUTPUT_DIR=output
# IMAGE_GEN_OUTPUT_DIR=temp_images

# ── 图片 / 视频理解（可选，独立模型） ─────────────────
# IMAGE_MODEL=
# IMAGE_API_KEY=
# IMAGE_BASE_URL=
# VIDEO_MODEL=
# VIDEO_API_KEY=
# VIDEO_BASE_URL=

# ── Telegram ──────────────────────────────────────────
# TG_BOT_TOKEN=
# TG_PROXY_URL=

# ── 主动追问 (proactive-plugin) ───────────────────────
# PROACTIVE_MODE=auto
# PROACTIVE_LOOP_INTERVAL=15

# ── ASR / TTS ─────────────────────────────────────────
# ASR_API_KEY=
# ASR_BASE_URL=
# ASR_MODEL=
# ASR_TIMEOUT_SECS=60
# TTS_API_KEY=
# TTS_BASE_URL=
# TTS_MODEL=
